# FibraOS Caddyfile — Sprint 7/8
# Maneja:
#   1. Wildcard DNS-01 para *.fibraos.com (subdominios tenant y apex)
#   2. on_demand_tls para dominios custom (tenants Pro+)
#   3. Reverse proxy a app:3000 (Next.js standalone)

{
  # Admin API interno (scope localhost, no exponer)
  admin :2019

  # Let's Encrypt prod
  email ops@{$ROOT_DOMAIN}

  # Gate para on_demand_tls: Caddy pregunta a nuestra API antes de pedir cert
  on_demand_tls {
    ask https://app.{$ROOT_DOMAIN}/api/internal/domain-authorize
    interval 2m
    burst 5
  }

  # Log JSON a stdout (capturado por docker logs)
  log {
    output stdout
    format json
  }
}

# ============ Wildcard FibraOS + apex ============
# DNS-01 con Cloudflare → emite un solo cert cubriendo *.fibraos.com y fibraos.com
*.{$ROOT_DOMAIN}, {$ROOT_DOMAIN} {
  tls {
    dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
  }

  encode zstd gzip

  # Headers forwarded para que el middleware resuelva el host real
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header Referrer-Policy strict-origin-when-cross-origin
  header X-Content-Type-Options nosniff

  reverse_proxy app:3000 {
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Real-IP {remote_host}
  }
}

# ============ Dominios custom (on_demand) ============
# Cualquier hostname externo (red.tmdigital.es, etc). TLS on-demand se dispara
# tras el ask endpoint.
:443 {
  tls {
    on_demand
  }

  encode zstd gzip

  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header Referrer-Policy strict-origin-when-cross-origin
  header X-Content-Type-Options nosniff

  reverse_proxy app:3000 {
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Real-IP {remote_host}
  }
}

# Healthcheck HTTP sin TLS (para load balancers / snapshots)
:80 {
  respond /healthz "ok" 200
  redir https://{host}{uri} permanent
}
